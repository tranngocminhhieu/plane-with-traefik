# ─────────────────────────────────────────────────────────────────────────────
# plane.local.env — phần cấu hình RIÊNG của bản deploy này.
#
# Chép file này thành plane.local.env rồi điền. plane.env (do setup.sh sinh ra)
# giữ nguyên bản gốc của Plane, không sửa dòng nào — mọi khác biệt nằm ở đây.
# Compose nạp hai file theo thứ tự, file sau đè file trước.
#
# ⚠ plane.local.env chứa secret: chmod 600, đã nằm trong .gitignore.
#   Sau lần khởi động ĐẦU TIÊN, các mật khẩu dưới đây đã được ghi vào data của
#   Postgres/RabbitMQ/MinIO. Đổi về sau mà không migrate là stack mất kết nối DB.
# ─────────────────────────────────────────────────────────────────────────────

# ── BƯỚC 0: điền domain ──────────────────────────────────────────────────────
# Domain phải trỏ sẵn (A record) về IP máy này thì Let's Encrypt mới cấp cert.
# Sửa domain ở đây thì PHẢI sửa cả label router trong docker-compose.override.yaml.
APP_DOMAIN=ticket.example.com

# Traefik lo TLS nên là https, khác mặc định http của Plane.
WEB_URL=https://${APP_DOMAIN}
CORS_ALLOWED_ORIGINS=https://${APP_DOMAIN}

# ── BƯỚC 0b: sinh secret ─────────────────────────────────────────────────────
# Chạy 1 lệnh này rồi dán kết quả vào 6 dòng dưới:
#   for i in 1 2; do openssl rand -hex 32; done; for i in 1 2; do openssl rand -hex 16; done
#
# Upstream để sẵn "change-this-key-on-deployment". SECRET_KEY ký session và token,
# lộ nó là giả được phiên đăng nhập của bất kỳ ai. ĐỪNG deploy với giá trị mặc định.
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

# Postgres — upstream mặc định plane/plane.
POSTGRES_PASSWORD=
# Upstream để DATABASE_URL rỗng rồi rơi về default plane:plane trong compose file,
# nên phải khai tường minh thì mật khẩu trên mới có tác dụng.
DATABASE_URL=postgresql://plane:${POSTGRES_PASSWORD}@plane-db/plane

# RabbitMQ — tương tự.
RABBITMQ_PASSWORD=
AMQP_URL=amqp://plane:${RABBITMQ_PASSWORD}@plane-mq:5672/plane

# MinIO — vừa là tài khoản root của MinIO, vừa là khoá S3 mà api/worker dùng.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
